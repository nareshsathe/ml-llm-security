# Copy this file to `.env` in the same folder and fill in real values.
# .env is already git-ignored — never commit real secrets.

PORT=5000
MONGO_URI=mongodb://localhost:27017/llm_security
ML_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-this-to-a-long-random-string

# --- LLM Provider ---
# "ollama" = runs 100% locally, no API key needed (recommended for demos)
# "groq"   = cloud API, needs a key from https://console.groq.com
LLM_PROVIDER=ollama

# --- Ollama config (used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# --- Groq config (used when LLM_PROVIDER=groq) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TLS_INSECURE=false

# --- Rate limiting ---
RATE_LIMIT_MAX=10
